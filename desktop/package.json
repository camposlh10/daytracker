{
  "name": "day-tracker",
  "productName": "Day Tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Personal desktop application for planning days, tracking reading, and reviewing progress.",
  "author": "Day Tracker",
  "main": "dist/main.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "npm run build && electron .",
    "pack": "electron-builder --win --x64 --dir",
    "dist": "electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "com.daytracker.app",
    "productName": "Day Tracker",
    "artifactName": "DayTracker-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "../backend/target/day-tracker-backend.jar",
        "to": "backend/backend.jar"
      },
      {
        "from": "resources/jre",
        "to": "jre"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Day Tracker"
    }
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2"
  }
}
